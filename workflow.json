    {
      "parameters": {
        "jsCode": "const output = $input.item.json.output;\n\nlet score = 0;\nconst raw = String(output.score_global || \"0\");\nconst match = raw.match(/[\\d]+([.,]\\d+)?/);\nif (match) score = parseFloat(match[0].replace(',', '.'));\nif (score > 10) score = 10;\nif (score < 0) score = 0;\n\nreturn {\n  ...output,\n  score_global_clean: score,\n  score_detail_clean: `Exp: ${output.score_experience}/10 | Comp: ${output.score_competences}/10 | Form: ${output.score_formation}/10`,\n  resume_clean: `${output.role_actuel} — ${output.realisations}`.substring(0, 500)\n};"
      },
      "type": "n8n-nodes-base.code",
